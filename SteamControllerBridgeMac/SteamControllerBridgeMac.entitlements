<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Uncomment after the "HID Virtual Device" capability is enabled for the
	com.arvindrao.SteamControllerBridgeMac app ID in the Apple Developer portal
	(Identifiers > app ID > Additional Capabilities). Signing with this
	entitlement before the provisioning profile includes it will make AMFI
	kill the app at launch.

	<key>com.apple.developer.hid.virtual.device</key>
	<true/>
	-->
</dict>
</plist>
